<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Product>OpenGimbalCam</Product>
    <Company>OpenGimbalCam</Company>
    <Authors>OpenGimbalCam contributors</Authors>
    <Copyright>Copyright (c) 2026 OpenGimbalCam contributors</Copyright>
    <RepositoryUrl>https://github.com/alsimoes/opengimbalcam</RepositoryUrl>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
