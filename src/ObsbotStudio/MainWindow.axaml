<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ObsbotStudio.ViewModels"
        xmlns:core="using:Obsbot.Core.Camera"
        x:Class="ObsbotStudio.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="OBSBOT Studio"
        Width="1240" Height="900" MinWidth="900" MinHeight="640">

  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Grid.dpad > Button">
      <Setter Property="Width" Value="60" />
      <Setter Property="Height" Value="60" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#14808080" />
      <Setter Property="BorderBrush" Value="#30808080" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="14">

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <TextBlock Text="Câmera" VerticalAlignment="Center" Margin="0,0,10,0" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="core:CameraInfo">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Name}" />
              <TextBlock Text="{Binding UsbId}" Opacity="0.6" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="2" Content="Atualizar" Command="{Binding RefreshCommand}" Margin="10,0,0,0" />
    </Grid>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      <TextBlock Grid.Column="1" Classes="hint" Text="{Binding PlatformName}" Margin="12,0,0,0" />
    </Grid>

    <Grid ColumnDefinitions="320,*,360">

      <!-- Gimbal / zoom / XU commands -->
      <Border Classes="card" Grid.Column="0">
        <ScrollViewer>
          <StackPanel Spacing="10" IsEnabled="{Binding HasCamera}" Margin="0,0,16,0">
            <TextBlock Classes="section" Text="Gimbal" />
            <Grid Classes="dpad" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto"
                  HorizontalAlignment="Center" IsEnabled="{Binding HasXu}">
              <Button x:Name="UpButton" Grid.Row="0" Grid.Column="1" Content="▲" ToolTip.Tip="Segure para mover" />
              <Button x:Name="LeftButton" Grid.Row="1" Grid.Column="0" Content="◀" ToolTip.Tip="Segure para mover" />
              <Button Grid.Row="1" Grid.Column="1" Content="⌂" Command="{Binding HomeCommand}"
                      ToolTip.Tip="Centralizar (pan/tilt absolutos = 0)" />
              <Button x:Name="RightButton" Grid.Row="1" Grid.Column="2" Content="▶" ToolTip.Tip="Segure para mover" />
              <Button x:Name="DownButton" Grid.Row="2" Grid.Column="1" Content="▼" ToolTip.Tip="Segure para mover" />
            </Grid>
            <TextBlock Text="{Binding Position}" HorizontalAlignment="Center" Classes="hint" />

            <TextBlock Text="Velocidade" />
            <Grid ColumnDefinitions="*,48">
              <Slider Minimum="1" Maximum="100" Value="{Binding Speed}" />
              <TextBlock Grid.Column="1" Text="{Binding Speed, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Classes="section" Text="Zoom" />
            <Grid ColumnDefinitions="*,48">
              <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Zoom}" />
              <TextBlock Grid.Column="1" Text="{Binding Zoom, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Classes="section" Text="Campo de visão" />
            <ComboBox ItemsSource="{Binding FovOptions}" SelectedIndex="{Binding FovIndex}"
                      HorizontalAlignment="Stretch" PlaceholderText="(não lido da câmera)" IsEnabled="{Binding HasXu}" />
            <ToggleSwitch Content="Espelhar imagem" IsChecked="{Binding Mirror}" IsEnabled="{Binding HasXu}" />

            <TextBlock Classes="section" Text="Presets" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding HasXu}">
              <Button Content="1" Command="{Binding TriggerPresetCommand}" CommandParameter="1" Width="48" />
              <Button Content="2" Command="{Binding TriggerPresetCommand}" CommandParameter="2" Width="48" />
              <Button Content="3" Command="{Binding TriggerPresetCommand}" CommandParameter="3" Width="48" />
            </StackPanel>
            <TextBlock Classes="hint" Text="Presets via XU seletor 7 (modelos mais antigos); FOV e espelho via seletor 6." />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Video preview + standard UVC controls -->
      <Border Classes="card" Grid.Column="1" Margin="12,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="section" Text="Vídeo" />
            <TextBlock Grid.Column="1" Classes="hint" Text="{Binding PreviewInfo}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
            <ToggleSwitch Grid.Column="2" IsChecked="{Binding PreviewEnabled}" OnContent="Ligado" OffContent="Desligado" />
          </Grid>
          <Border DockPanel.Dock="Top" Background="Black" CornerRadius="6" Height="320" Margin="0,4,0,12" ClipToBounds="True">
            <Image Source="{Binding Frame}" Stretch="Uniform" />
          </Border>
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="Imagem (controles UVC)" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Controls}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ControlViewModel">
                  <Grid ColumnDefinitions="Auto,*,56,70" Margin="0,2">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MinWidth="170" />
                    <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}"
                            TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                            Value="{Binding Value}" IsEnabled="{Binding !Auto}" />
                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <CheckBox Grid.Column="3" Content="Auto" IsChecked="{Binding Auto}" IsVisible="{Binding HasAuto}" Margin="10,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- OSC server -->
      <Border Classes="card" Grid.Column="2">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8">
            <TextBlock Classes="section" Text="Servidor OSC" />
            <TextBlock Classes="hint"
                       Text="Protocolo /OBSBOT/WebCam/* do OBSBOT Center: TouchOSC, Bitfocus Companion, Stream Deck. Feche o OBSBOT Center antes (mesma porta)." />
            <StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding !OscRunning}">
              <TextBlock Text="Porta" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding OscPort}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" Width="140" />
              <CheckBox Content="UDP" IsChecked="{Binding OscUdp}" />
              <CheckBox Content="TCP" IsChecked="{Binding OscTcp}" />
            </StackPanel>
            <Button Content="{Binding OscButtonText}" Command="{Binding ToggleOscCommand}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Log}" Margin="0,10,0,0" FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" FontSize="11" />
        </DockPanel>
      </Border>

    </Grid>
  </DockPanel>
</Window>
