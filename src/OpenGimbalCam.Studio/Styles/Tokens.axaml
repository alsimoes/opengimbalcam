<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Design tokens (ADR-0012). Always consumed with DynamicResource. -->
  <SolidColorBrush x:Key="AppBg" Color="#0D0F12"/>
  <SolidColorBrush x:Key="PanelBg" Color="#15181D"/>
  <SolidColorBrush x:Key="RaisedBg" Color="#1D2128"/>
  <SolidColorBrush x:Key="HoverBg" Color="#262B33"/>
  <SolidColorBrush x:Key="PressedBg" Color="#2E343E"/>
  <SolidColorBrush x:Key="BorderSubtle" Color="#262B33"/>
  <SolidColorBrush x:Key="BorderStrong" Color="#39404B"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#E8EAED"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#B4BAC3"/>
  <SolidColorBrush x:Key="TextMuted" Color="#8A919C"/>
  <SolidColorBrush x:Key="Accent" Color="#6C5CE7"/>
  <SolidColorBrush x:Key="AccentHover" Color="#7D6FF0"/>
  <SolidColorBrush x:Key="AccentPressed" Color="#5B4BD5"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentSubtle" Color="#2A2550"/>
  <SolidColorBrush x:Key="AccentText" Color="#A99FF7"/>
  <SolidColorBrush x:Key="Danger" Color="#EF4444"/>
  <SolidColorBrush x:Key="DangerFill" Color="#DC2626"/>
  <SolidColorBrush x:Key="DangerHover" Color="#E53E3E"/>
  <SolidColorBrush x:Key="DangerPressed" Color="#B91C1C"/>
  <SolidColorBrush x:Key="DangerText" Color="#F87171"/>
  <SolidColorBrush x:Key="Success" Color="#22C55E"/>
  <SolidColorBrush x:Key="Warning" Color="#F59E0B"/>
  <SolidColorBrush x:Key="VideoBg" Color="#000000"/>
  <SolidColorBrush x:Key="OverlayBg" Color="#B3000000"/>
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#7D6FF0" Offset="0"/>
    <GradientStop Color="#4B3CC4" Offset="1"/>
  </LinearGradientBrush>

  <!-- Fluent theme overrides -->
  <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter, $Default</FontFamily>
  <FontFamily x:Key="MonoFont">avares://opengimbalcam-studio/Assets/Fonts#JetBrains Mono</FontFamily>
  <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
  <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
  <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
  <CornerRadius x:Key="SliderThumbCornerRadius">7</CornerRadius>
  <x:Double x:Key="SliderHorizontalHeight">24</x:Double>
  <GridLength x:Key="SliderPreContentMargin">5</GridLength>
  <GridLength x:Key="SliderPostContentMargin">5</GridLength>
  <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
  <x:Double x:Key="TabItemMinHeight">36</x:Double>
  <SolidColorBrush x:Key="NotificationCardBackground" Color="#1D2128"/>
</ResourceDictionary>
