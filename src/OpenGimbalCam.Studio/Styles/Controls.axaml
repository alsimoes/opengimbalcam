<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OpenGimbalCam.Studio.Controls">
  <!-- Component styles (ADR-0012). Must come after the FluentTheme: state brushes live on the template presenter. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource RaisedBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerHover}"/>
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerPressed}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerPressed}"/>
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="Button.icon.mini">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
  </Style>
  <Style Selector="ToggleButton.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>
  <Style Selector="ToggleButton.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="ToggleButton.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="ToggleButton.icon">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>
  <Style Selector="ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="ToggleButton.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="ToggleButton.icon.mini">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="22"/>
  </Style>
  <Style Selector="ToggleButton.ghost:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style Selector="ToggleButton.ghost:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style Selector="ToggleButton.ghost:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style Selector="ToggleButton.icon:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style Selector="ToggleButton.icon:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style Selector="Grid.pad > Button">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Margin" Value="2"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.home">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style Selector="Button.home:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style Selector="Button.home:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style Selector="Button.preset">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.shutter">
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="CornerRadius" Value="22"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource RaisedBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.record">
    <Setter Property="Height" Value="40"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.record:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
  </Style>
  <Style Selector="Button.record:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
  </Style>
  <Style Selector="Button.record c|Glyph">
    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
  </Style>
  <Style Selector="Button.record.recording">
    <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
  </Style>
  <Style Selector="Button.record.recording /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFill}"/>
  </Style>
  <Style Selector="Button.record.recording:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerHover}"/>
  </Style>
  <Style Selector="Button.record.recording:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerPressed}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerPressed}"/>
  </Style>
  <Style Selector="Button.record.recording c|Glyph">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
  </Style>
  <Style Selector="ToggleButton.chip">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="{DynamicResource RaisedBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="ToggleButton.chip:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{DynamicResource RaisedBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem">
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
  </Style>
  <Style Selector="ListBox.segmented ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
  </Style>
  <Style Selector="ListBox.log">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem">
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style Selector="TabItem c|Glyph">
    <Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <Style Selector="Border.appbar">
    <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource RaisedBg}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style Selector="Border.stage">
    <Setter Property="Background" Value="{DynamicResource VideoBg}"/>
    <Setter Property="CornerRadius" Value="10,10,0,0"/>
    <Setter Property="Focusable" Value="True"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Border.stage:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="Border.transport">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>
  <Style Selector="Border.vdivider">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
    <Setter Property="Margin" Value="10,2"/>
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource OverlayBg}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>
  <Style Selector="Border.recBadge">
    <Setter Property="Background" Value="{DynamicResource OverlayBg}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource RaisedBg}"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Padding" Value="10,4"/>
  </Style>
  <Style Selector="Border.brandmark">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
  </Style>
  <Style Selector="Border.brandmark c|Glyph">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="Fill" Value="{DynamicResource TextMuted}"/>
  </Style>
  <Style Selector="Ellipse.dot.ok">
    <Setter Property="Fill" Value="{DynamicResource Success}"/>
  </Style>
  <Style Selector="Ellipse.dot.warn">
    <Setter Property="Fill" Value="{DynamicResource Warning}"/>
  </Style>
  <Style Selector="Ellipse.recDot">
    <Setter Property="Width" Value="9"/>
    <Setter Property="Height" Value="9"/>
    <Setter Property="Fill" Value="{DynamicResource Danger}"/>
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.2"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="TextBlock.brand">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.brandSub">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="MinWidth" Value="48"/>
  </Style>
  <Style Selector="TextBlock.readout">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource DangerText}"/>
  </Style>
  <Style Selector="c|Glyph.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RaisedBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFill}"/>
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>
  <Style Selector="ToggleButton.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>
  <Style Selector="ToggleButton.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>
  <Style Selector="ToggleButton.ghost:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style Selector="ToggleButton.icon:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
  </Style>
  <Style Selector="Button.home:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSubtle}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
  </Style>
  <Style Selector="Button.record:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
  </Style>
  <Style Selector="Button.record.recording:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DangerFill}"/>
  </Style>
  <Style Selector="Button.shutter:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RaisedBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
  </Style>
  <Style Selector="ToggleButton.chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RaisedBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource RaisedBg}"/>
  </Style>
  <Style Selector="ToggleButton.chip:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
</Styles>
