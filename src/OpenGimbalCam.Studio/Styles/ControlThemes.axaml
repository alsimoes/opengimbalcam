<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:OpenGimbalCam.Studio.Controls">
  <!-- 16x16 canvas keeps the Bootstrap viewBox, so every icon has the same optical size. -->
  <ControlTheme x:Key="{x:Type c:Glyph}" TargetType="c:Glyph">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Stretch="Uniform">
          <Canvas Width="16" Height="16">
            <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}"/>
          </Canvas>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
